# ==============================================================================
# Nepali PDF Text Extractor Configuration (.env)
# ==============================================================================
# Copy this file to .env and adjust values as needed for your environment.
# All settings are optional; defaults shown below will be used if omitted.
# Note: CLI arguments always take precedence over these values.

# ------------------------------------------------------------------------------
# Concurrency & Performance
# ------------------------------------------------------------------------------
# Number of parallel worker threads for batch directory processing
WORKERS=4

# ------------------------------------------------------------------------------
# Stage Timeouts (in seconds)
# Increase these values when processing very large or complex PDFs (e.g. 1000+ pages)
# ------------------------------------------------------------------------------
# Timeout for font inspection with pdffonts
PDFFONTS_TIMEOUT=120

# Timeout for direct text extraction with pdftotext (Poppler)
PDFTOTEXT_TIMEOUT=900

# Timeout for font-fallback extraction with pdfminer.six
PDFMINER_TIMEOUT=1200

# Timeout for OCR fallback with ocrmypdf
OCR_TIMEOUT=5400

# ------------------------------------------------------------------------------
# OCR Configuration (ocrmypdf / Tesseract)
# ------------------------------------------------------------------------------
# Languages to use for OCR, joined with '+' (e.g., nep+hin+eng, nep+eng, nep)
OCR_LANGUAGES=nep+hin+eng

# Resolution (DPI) for image rasterization during OCR
OCR_IMAGE_DPI=300

# Optimization level for ocrmypdf (0 = disabled, 1 = safe/standard, 2 = lossy)
OCR_OPTIMIZE=1
